{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Prompt Library",
  "version": "0.1.0",
  "identifier": "com.bosscube1.prompt-library",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Library",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "bosscube1",
    "copyright": "Copyright (c) 2026 bosscube1",
    "category": "Productivity",
    "shortDescription": "Local prompt library, template filler and LLM prompt enhancer.",
    "longDescription": "A local prompt library with ~540 prompts, a {{variable}} template filler, and an LLM-backed prompt enhancer. Runs entirely on this machine - no backend, no telemetry, no account. API keys are stored in the app's local storage only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
